{
  "manifest_version": 3,
  "name": "ShieldGuard - Real-Time Phishing Detector",
  "version": "1.0.0",
  "description": "Real-time AI phishing URL detection powered by XGBoost & FastAPI.",
  "permissions": ["tabs", "activeTab"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ShieldGuard Status"
  }
}